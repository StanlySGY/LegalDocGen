# Copy this file to .env.production on your server and replace every secret.

# Public entry
HTTP_PORT=80
VITE_PRODUCT_MODE=personal_lawyer

# PostgreSQL
POSTGRES_DB=legaldocgen
POSTGRES_USER=legaldocgen
POSTGRES_PASSWORD=replace-with-a-strong-db-password
DATABASE_URL=postgresql+psycopg://legaldocgen:replace-with-a-strong-db-password@db:5432/legaldocgen

# Backend security
AUTH_REQUIRED=true
AUTH_TOKEN_EXPIRE_HOURS=24
ALLOW_USER_REGISTRATION=false
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=replace-with-a-strong-initial-admin-password
ADMIN_TOKEN=replace-with-a-long-random-admin-token
API_KEY_SECRET=replace-with-a-long-random-api-key-secret
AUTH_SECRET=replace-with-a-long-random-auth-secret

# Same-origin Docker deployment should use the public origin only.
# Example: https://law.example.com
# If you only test by server IP over HTTP, use http://your-server-ip
CORS_ORIGINS=https://your-domain.example.com

# Uploads
MAX_FILE_SIZE=52428800

# Default model channel. You can also configure channels inside the app.
DEFAULT_MODEL=openai
DEFAULT_MODEL_NAME=mimo-v2.5-pro
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_NAME=mimo-v2.5-pro
CLAUDE_API_KEY=
CUSTOM_API_KEY=
CUSTOM_BASE_URL=
CUSTOM_MODEL_NAME=
