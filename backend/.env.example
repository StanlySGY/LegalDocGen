# 模型渠道（也可在前端渠道管理中维护）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_NAME=mimo-v2.5-pro
CLAUDE_API_KEY=
CUSTOM_API_KEY=
CUSTOM_BASE_URL=
CUSTOM_MODEL_NAME=
DEFAULT_MODEL=openai
DEFAULT_MODEL_NAME=mimo-v2.5-pro

# 数据库
# 本地默认 SQLite；试运营建议 PostgreSQL：postgresql+psycopg://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./legaldocgen.db

# 文件存储
UPLOAD_DIR=./uploads
STORAGE_BACKEND=local
MAX_FILE_SIZE=52428800

# 前端与跨域
# 本地： http://localhost:5173
# 试运营： https://your-frontend.example.com
CORS_ORIGINS=http://localhost:5173

# 管理与密钥
# 试运营必须替换为高强度随机字符串，并避免提交真实值
ADMIN_TOKEN=change-me-admin-token
API_KEY_SECRET=change-me-api-key-secret
AUTH_SECRET=change-me-auth-secret

# 登录权限
AUTH_REQUIRED=false
AUTH_TOKEN_EXPIRE_HOURS=24
ALLOW_USER_REGISTRATION=true
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=

# 前端部署变量（配置在 Vercel/Netlify，不由后端读取）
# VITE_API_BASE_URL=https://your-backend.example.com/api
